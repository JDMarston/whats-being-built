{
  "name": "whats-being-built",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "mobile:open": "node scripts/open-mobile-preview.mjs",
    "check": "npm run check:types && npm run check:data && npm run check:map",
    "check:map": "node --experimental-strip-types --test scripts/check-map.mjs",
    "check:types": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "check:data": "node scripts/check-data-ingestion.mjs",
    "ingest:sources": "node scripts/ingest-sources.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "review:candidates": "node scripts/review-candidates.mjs",
    "geocode:candidates": "node scripts/geocode-candidates.mjs"
  },
  "dependencies": {
    "maplibre-gl": "^5.24.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "typescript": "^5.9.3",
    "vite": "^8.1.5"
  },
  "description": "A map of construction projects, starting in St. Petersburg, Florida."
}
